# Environment Variables Template
# Copy this file to .env.local and fill in your values

# App Configuration
NEXT_PUBLIC_APP_NAME="calendar-aggregator"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Configuration (required for persistent calendar storage)
# Server-only. The service-role key bypasses RLS: never prefix it with
# NEXT_PUBLIC_, never commit it, never expose it to the browser.
SUPABASE_URL="your-project-url"            # falls back to NEXT_PUBLIC_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database (if needed)
# DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# Authentication (if needed)
# NEXTAUTH_SECRET="your-secret-here"
# NEXTAUTH_URL="http://localhost:3000"

# API Keys (if needed)
# OPENAI_API_KEY="your-openai-key"
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_SECRET_KEY="sk_test_..."

# Email Service (if needed)
# RESEND_API_KEY="re_..."

# Analytics (if needed)
# NEXT_PUBLIC_GA_ID="G-..."