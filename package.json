{
  "name": "calendar-aggregator",
  "version": "0.1.41",
  "description": "Combine multiple iCal feeds into one subscribable calendar URL",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@testing-library/dom": "10.4.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "next": "^16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.4.3",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "postcss": "8.5.31",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.x",
      "onFail": "warn"
    }
  }
}
